{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM"],
    "strict": true, "noImplicitOverride": true, "noFallthroughCasesInSwitch": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "isolatedModules": true, "skipLibCheck": true, "noEmit": true, "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": { "@kernel": ["src/kernel/index.ts"], "@pack/*": ["packs/*"] }
  },
  "include": ["src", "packs", "tests", "tools/sim", "vite.config.ts"]
}
